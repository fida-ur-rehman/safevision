# Copy to .env and fill in. .env is ignored by git and must not be committed.
GROQ_API_KEY=
LLM_BACKEND=groq               # groq | ollama | template (template = no language model, works offline)
LLM_MODEL=openai/gpt-oss-20b   # Groq retired llama-3.1-8b-instant (free tier) in Aug 2026
# LLM_BACKEND=ollama  and  LLM_MODEL=llama3.1:8b  to run fully offline with Ollama
MATCH_METHOD=box               # box | pose (box was as good as pose in Notebook 2, and faster)
USE_RERANKER=1                 # 0 = faster rule search on a weak laptop
NLI_MODEL=cross-encoder/nli-deberta-v3-base
CORS_ORIGINS=http://localhost:3000
BLUR_FACES=1                   # privacy: faces are blurred in saved photos (0 = keep photos sharp)
# ZOOM_ITEMS=helmet,vest,gloves  # zoom re-check items (default: the choice of Notebook 2x)
# SAFEVISION_DEVICE=cpu        # force CPU
